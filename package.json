{
  "name": "@dada78641/cronbot",
  "description": "Bot that schedules and runs periodic tasks that push information to Discord",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./util": {
      "types": "./dist/util.d.ts",
      "import": "./dist/util.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "readme.md"
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch src",
    "check": "tsc -p ./tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --flag unstable_ts_config",
    "db:generate": "tsx node_modules/.bin/drizzle-kit generate --config=src/lib/db/config.ts --name=migration"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msikma/cronbot.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/eslint": "^9.6.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.8.6",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.0.0",
    "jiti": "^2.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "@dada78641/env-paths": "^0.1.0",
    "@dada78641/repo-version": "^0.1.2",
    "better-sqlite3": "^11.7.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "lodash-es": "^4.17.21",
    "sanitize-filename": "^1.6.3",
    "tmp-promise": "^3.0.3"
  }
}
